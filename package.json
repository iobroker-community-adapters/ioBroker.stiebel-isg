{
  "name": "iobroker.stiebel-isg",
  "version": "2.0.3",
  "description": "stiebel/tecalor internet service gateway",
  "author": "Michael Schuster <development@unltd-networx.de>",
  "contributors": [
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>",
    "mcm1957 <mcm57@gmx.at>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.stiebel-isg",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Stiebel-Eltron/Tecalor",
    "Internet Service Gateway",
    "ISG"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.stiebel-isg"
  },
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2",
    "cheerio": "^1.2.0",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.1.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.1.2",
    "@alcalzone/release-script-plugin-license": "^5.1.1",
    "@alcalzone/release-script-plugin-manual-review": "^5.1.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.stiebel-isg/issues"
  },
  "readmeFilename": "README.md"
}
